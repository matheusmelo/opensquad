# ============================================================
# OpenSquad — ENV template (copie para .env e preencha)
# ============================================================

# Orchestrator
ORCHESTRATOR_PORT=3001
ORCHESTRATOR_WS_PORT=3002
OPENSQUAD_BASE_PATH=C:/inetpub/opensquad
MAX_CONCURRENT_SQUADS=3

# AI Providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
GROK_API_KEY=
DEEPGRAM_API_KEY=

# Auth
JWT_SECRET=change-me-in-prod
API_KEY=dev-key-change-in-production

# Database
DATABASE_URL=file:./prisma/dev.db
DB_PASSWORD=changeme

# Queue
REDIS_URL=redis://localhost:6379

# Alertas de budget
DAILY_BUDGET_USD=5.0
ALERT_WEBHOOK=

# Observability
SENTRY_DSN=
LOG_LEVEL=debug

# Frontend (Vite)
VITE_API_URL=http://localhost:3001
VITE_WS_URL=ws://localhost:3002
VITE_SENTRY_DSN=

# Open Finance (Pluggy) — https://dashboard.pluggy.ai
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
# Mostrar o banco de teste "Pluggy Bank" no widget (false em produção)
PLUGGY_INCLUDE_SANDBOX=true
# Webhook precisa de URL pública HTTPS (opcional em dev)
PLUGGY_WEBHOOK_URL=
PLUGGY_WEBHOOK_SECRET=
# Dono das conexões (User.whatsappNumber)
PLUGGY_OWNER_WHATSAPP=+5511999999999

# WhatsApp
WHATSAPP_SESSION_PATH=./data/sessions

# Deploy
NODE_ENV=development
PORT=3001
