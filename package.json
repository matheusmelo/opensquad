{
  "name": "opensquad-project",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev:orchestrator": "cd orchestrator && node orchestrator.js",
    "dev:whatsapp": "cd skills/whatsapp-integration && node mcp-whatsapp-server.js",
    "dev:dashboard": "cd shlomo-ledger && npm run dev",
    "dev": "concurrently \"npm run dev:orchestrator\" \"npm run dev:whatsapp\" \"npm run dev:dashboard\"",
    "build": "npm run build:all",
    "build:all": "cd shlomo-ledger && npm run build",
    "start": "pm2 start deploy/ecosystem.config.js",
    "stop": "pm2 stop all",
    "logs": "pm2 logs",
    "deploy:setup": "bash deploy/setup-ubuntu.sh",
    "healthcheck": "bash deploy/healthcheck.sh"
  },
  "dependencies": {
    "@prisma/client": "^7.7.0",
    "cors": "^2.8.6",
    "playwright": "^1.58.2",
    "prisma": "^7.7.0",
    "sqlite3": "^6.0.1"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
